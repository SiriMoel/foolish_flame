<Entity name="$projectile_default" tags="projectile_player" >

	<Base file="data/entities/base_projectile.xml" >
		<VelocityComponent
			gravity_y="200"
			air_friction="1.1"
			mass="0.08"
			>
		</VelocityComponent>
	</Base>

  <ProjectileComponent
    lob_min="0.5"
    lob_max="0.7"
    speed_min="500"
    speed_max="550"
    friction="1"
    direction_random_rad="0.01"
    on_death_explode="1"
    on_death_gfx_leave_sprite="0" 
    on_lifetime_out_explode="1"
    explosion_dont_damage_shooter="1"
    on_collision_die="1"
    lifetime="50"
    damage="0.2"
    velocity_sets_scale="1"
    lifetime_randomness="4"
    ragdoll_force_multiplier="0.04"
    hit_particle_force_multiplier="0.1"
	muzzle_flash_file="data/entities/particles/muzzle_flashes/muzzle_flash_launcher.xml"
    shoot_light_flash_r="140"
    shoot_light_flash_g="60"
    shoot_light_flash_b="100"
    shoot_light_flash_radius="72" 
	  knockback_force="1.2"
    physics_impulse_coeff="1500"
    >
    <damage_by_type
      fire="0.15"
    ></damage_by_type>
    <config_explosion
    never_cache="1" 
    damage="0"
    camera_shake="0.5" 
    explosion_radius="2" 
    explosion_sprite="data/particles/explosion_032.xml"
    explosion_sprite_lifetime="0" 
    create_cell_probability="0" 
    hole_destroy_liquid="0"
    explosion_sprite_additive="1"
    hole_enabled="1" 
    ray_energy="400000"
    max_durability_to_destroy="8"
    particle_effect="0" 
    damage_mortals="1"
    physics_explosion_power.min="0.02" 
    physics_explosion_power.max="0.1" 
    physics_throw_enabled="1"  
    shake_vegetation="1" 
    sparks_count_max="20" 
    sparks_count_min="7" 
    sparks_enabled="0"  
    material_sparks_enabled="1"
    material_sparks_count_max="2"
    material_sparks_count_min="0" 
    light_enabled="1" 
    light_r="140"
    light_g="100"
    light_b="60"
    stains_enabled="1"
    stains_radius="3"
    >
    </config_explosion>
  </ProjectileComponent>
  
  <SpriteComponent 
    _enabled="1" 
    alpha="1" 
    image_file="mods/foolish_flame/files/entities/projectiles/heat_flare/sprite.xml"
    next_rect_animation=""
    rect_animation="" 
    additive="1"
    >
  </SpriteComponent>
  
	<ParticleEmitterComponent 
		emitted_material_name="spark"
		offset.x="0"
		offset.y="0"
		x_pos_offset_min="-2"
		x_pos_offset_max="2"
		y_pos_offset_min="-2"
		y_pos_offset_max="2"
		x_vel_min="0"
		x_vel_max="0"
		y_vel_min="0"
		y_vel_max="0"
		gravity.y="0.0"
		count_min="1"
		count_max="3"
		lifetime_min="0.5"
		lifetime_max="0.9"
		is_trail="1"
		trail_gap="1.0"
		render_on_grid="1"
		fade_based_on_lifetime="1"
		airflow_force="0.5"
		airflow_time="0.001"
		airflow_scale="0.0833"
		emission_interval_min_frames="1"
		emission_interval_max_frames="1"
		emit_cosmetic_particles="1"
		create_real_particles="0"
		is_emitting="1"
    >
	</ParticleEmitterComponent>

  <ParticleEmitterComponent 
		emitted_material_name="spark_green"
		offset.x="0"
		offset.y="0"
		x_pos_offset_min="-1"
		x_pos_offset_max="1"
		y_pos_offset_min="-1"
		y_pos_offset_max="1"
		x_vel_min="0"
		x_vel_max="0"
		y_vel_min="0"
		y_vel_max="0"
		gravity.y="0.0"
		count_min="0"
		count_max="2"
		lifetime_min="0.4"
		lifetime_max="0.6"
		is_trail="1"
		trail_gap="1.0"
		render_on_grid="1"
		fade_based_on_lifetime="1"
		airflow_force="0.5"
		airflow_time="0.001"
		airflow_scale="0.0833"
		emission_interval_min_frames="1"
		emission_interval_max_frames="1"
		emit_cosmetic_particles="1"
		create_real_particles="0"
		is_emitting="1"
    >
	</ParticleEmitterComponent>
	
  <AudioComponent
      file="data/audio/Desktop/projectiles.bank"
      event_root="player_projectiles/bullet_fire_heavy">
  </AudioComponent>
  
  <LightComponent 
    radius="40" 
  	r="140"
  	g="100"
  	b="60"
    >
  </LightComponent>
  
	<VariableStorageComponent
		name="projectile_file"
		value_string="mods/foolish_flame/files/entities/projectiles/heat_flare/projectile.xml"
		>
	</VariableStorageComponent>

</Entity>

