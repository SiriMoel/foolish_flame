<Entity name="$projectile_default" tags="projectile_player" >

	<Base file="data/entities/base_projectile.xml" >
		<VelocityComponent
			gravity_y="200"
			air_friction="1.1"
			mass="0.08"
			>
		</VelocityComponent>
	</Base>

  <ProjectileComponent
    lob_min="0.5"
    lob_max="0.7"
    speed_min="400"
    speed_max="450"
    friction="1"
    direction_random_rad="0.01"
    on_death_explode="1"
    on_death_gfx_leave_sprite="0" 
    on_lifetime_out_explode="1"
    explosion_dont_damage_shooter="1"
    lifetime="70"
    damage="0.1"
    velocity_sets_scale="1"
    lifetime_randomness="4"
    ragdoll_force_multiplier="0.04"
    hit_particle_force_multiplier="0.1"
	muzzle_flash_file="data/entities/particles/muzzle_flashes/muzzle_flash_launcher.xml"
    shoot_light_flash_r="255"
    shoot_light_flash_g="255"
    shoot_light_flash_b="80"
    shoot_light_flash_radius="80" 
	knockback_force="2.3"
    physics_impulse_coeff="1500"
    on_collision_spawn_entity="1"
    spawn_entity="mods/foolish_flame/files/entities/projectiles/aoe_flare/explode.xml"
    >
    <damage_by_type
      fire="0.1"
    ></damage_by_type>
    <config_explosion
      never_cache="1" 
      camera_shake="4.5" 
      explosion_radius="35" 
      explosion_sprite="data/particles/explosion_008.xml" 
      explosion_sprite_lifetime="0" 
	  ray_energy="200000"
      create_cell_probability="100" 
      create_cell_material="fire" 
      hole_destroy_liquid="0" 
      damage="0.2"
      hole_enabled="1" 
      hole_image="data/temp/explosion_hole.png" 
      particle_effect="1" 
      damage_mortals="1"
	  physics_explosion_power.max="0.1" 
      physics_explosion_power.max="0.3" 
      physics_throw_enabled="1" 
      shake_vegetation="0" 
	  spark_material="spark_yellow"
      sparks_count_min="20"
	  sparks_count_max="40"
	  sparks_enabled="1"
      light_fade_time="0.8" 
      stains_enabled="1" 
      stains_image="data/temp/explosion_stain.png" 
	  audio_event_name="explosions/fire"
	  >
    </config_explosion>
  </ProjectileComponent>
  
  <SpriteComponent 
    _enabled="1" 
    alpha="1" 
    image_file="mods/foolish_flame/files/entities/projectiles/aoe_flare/sprite.xml"
    next_rect_animation=""
    rect_animation="" 
    additive="1"
    >
  </SpriteComponent>
  
	<ParticleEmitterComponent 
		emitted_material_name="spark"
		offset.x="0"
		offset.y="0"
		x_pos_offset_min="-2"
		x_pos_offset_max="2"
		y_pos_offset_min="-2"
		y_pos_offset_max="2"
		x_vel_min="0"
		x_vel_max="0"
		y_vel_min="0"
		y_vel_max="0"
		gravity.y="0.0"
		count_min="1"
		count_max="3"
		lifetime_min="0.5"
		lifetime_max="0.9"
		is_trail="1"
		trail_gap="1.0"
		render_on_grid="1"
		fade_based_on_lifetime="1"
		airflow_force="0.5"
		airflow_time="0.001"
		airflow_scale="0.0833"
		emission_interval_min_frames="1"
		emission_interval_max_frames="1"
		emit_cosmetic_particles="1"
		create_real_particles="0"
		is_emitting="1"
    >
	</ParticleEmitterComponent>

  <ParticleEmitterComponent 
		emitted_material_name="spark_yellow"
		offset.x="0"
		offset.y="0"
		x_pos_offset_min="-3"
		x_pos_offset_max="3"
		y_pos_offset_min="-3"
		y_pos_offset_max="3"
		x_vel_min="0"
		x_vel_max="0"
		y_vel_min="0"
		y_vel_max="0"
		gravity.y="0.0"
		count_min="3"
		count_max="5"
		lifetime_min="0.4"
		lifetime_max="1.1"
		is_trail="1"
		trail_gap="1.0"
		render_on_grid="1"
		fade_based_on_lifetime="1"
		airflow_force="0.5"
		airflow_time="0.001"
		airflow_scale="0.0833"
		emission_interval_min_frames="1"
		emission_interval_max_frames="1"
		emit_cosmetic_particles="1"
		create_real_particles="0"
		is_emitting="1"
    >
	</ParticleEmitterComponent>
	
  <AudioComponent
      file="data/audio/Desktop/projectiles.bank"
      event_root="player_projectiles/bullet_fire_heavy">
  </AudioComponent>
  
  <LightComponent
    _enabled="1" 
    radius="80" 
  	r="255"
  	g="255"
  	b="80"
    >
  </LightComponent>
  
	<VariableStorageComponent
		name="projectile_file"
		value_string="mods/foolish_flame/files/entities/projectiles/aoe_flare/projectile.xml"
		>
	</VariableStorageComponent>

</Entity>

