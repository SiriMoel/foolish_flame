<Entity name="$projectile_default" tags="projectile_player" >

	<Base file="data/entities/base_projectile.xml" >
		<VelocityComponent
			gravity_y="90"
			air_friction="0.9"
			mass="0.05"
			>
		</VelocityComponent>
	</Base>

  <ProjectileComponent
    lob_min="0.5"
    lob_max="0.7"
    speed_min="400"
    speed_max="900"
    friction="1"
    direction_random_rad="0.01"
    on_death_explode="0"
    on_death_gfx_leave_sprite="0" 
    on_lifetime_out_explode="0"
    on_collision_die="0"
    lifetime="80"
    damage="0.06"
    velocity_sets_scale="1"
    lifetime_randomness="4"
    ragdoll_force_multiplier="0.04"
    hit_particle_force_multiplier="0.1"
	muzzle_flash_file="data/entities/particles/muzzle_flashes/muzzle_flash_launcher.xml"
    shoot_light_flash_r="220"
    shoot_light_flash_g="180"
    shoot_light_flash_b="100"
    shoot_light_flash_radius="42" 
	knockback_force="0.4"
    physics_impulse_coeff="800"
    penetrate_entities="1"
    ground_penetration_coeff="3"
    >
    <damage_by_type
      fire="0.1"
      holy="0.06"
    ></damage_by_type>
  </ProjectileComponent>
  
  <SpriteComponent 
    _enabled="1" 
    alpha="1" 
    image_file="mods/foolish_flame/files/entities/projectiles/needle/sprite.xml"
    next_rect_animation=""
