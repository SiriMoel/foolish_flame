<Entity name="$projectile_default" tags="projectile_player" >

	<Base file="data/entities/base_projectile.xml" >
		<VelocityComponent
			gravity_y="0"
			air_friction="0.5"
			mass="0.01"
			>
		</VelocityComponent>
	</Base>

  <ProjectileComponent
    lob_min="0.2"
    lob_max="0.4"
    speed_min="400"
    speed_max="450"
    friction="1"
    direction_random_rad="0.01"
    on_death_explode="0"
    on_death_gfx_leave_sprite="0" 
    on_lifetime_out_explode="0"
    explosion_dont_damage_shooter="1"
    on_collision_die="0"
    penetrate_entities="1"
    penetrate_world="1"
    lifetime="110"
    damage="0.12"
    velocity_sets_scale="0"
    lifetime_randomness="4"
    ragdoll_force_multiplier="0.04"
    hit_particle_force_multiplier="0.1"
	muzzle_flash_file="data/entities/particles/muzzle_flashes/muzzle_flash_launcher.xml"
    shoot_light_flash_r="255"
    shoot_light_flash_g="170"
    shoot_light_flash_b="100"
    shoot_light_flash_radius="72" 
	knockback_force="2.3"
    physics_impulse_coeff="1500"
    >
    <damage_by_type
      fire="0.08"
      holy="0.04"
    ></damage_by_type>
  </ProjectileComponent>

  <GameAreaEffectComponent
      radius="6"
      collide_with_tag="hittable"
      frame_length="0"
  ></GameAreaEffectComponent>
  
  <!--<SpriteComponent 
    _enabled="1" 
    alpha="1" 
    image_file="mods/foolish_flame/files/entities/projectiles/laser/sprite.xml"
    next_rect_animation=""
    rect_animation="" 
    additive="1"
    >
  </SpriteComponent>-->
  
	<ParticleEmitterComponent 
		emitted_material_name="spark"
		offset.x="0"
		offset.y="0"
		x_pos_offset_min="-5"
		x_pos_offset_max="5"
		y_pos_offset_min="-5"
		y_pos_offset_max="5"
		x_vel_min="0"
		x_vel_max="0"
		y_vel_min="0"
		y_vel_max="0"
		gravity.y="0.0"
		count_min="6"
		count_max="10"
		lifetime_min="0.5"
		lifetime_max="0.9"
		is_trail="1"
		trail_gap="1.0"
		render_on_grid="1"
		fade_based_on_lifetime="1"
		airflow_force="0.5"
		airflow_time="0.001"
		airflow_scale="0.0833"
		emission_interval_min_frames="1"
		emission_interval_max_frames="1"
		emit_cosmetic_particles="1"
		create_real_particles="0"
		is_emitting="1"
    >
	</ParticleEmitterComponent>

  <SpriteParticleEmitterComponent
		sprite_file="mods/foolish_flame/files/entities/projectiles/flare/particles.xml"
		delay="0"
		lifetime="0"
		color.r="1" color.g="1" color.b="1" color.a="1"
		color_change.r="0" color_change.g="0" color_change.b="0" color_change.a="0"
    velocity.x="0" velocity.y="0"
        gravity.x="0" gravity.y="0"
        velocity_slowdown="0"
        rotation="0"
        angular_velocity="0"
        use_velocity_as_rotation="0"
        scale.x="1" scale.y="1"
        scale_velocity.x="0" scale_velocity.y="0"
        emission_interval_min_frames="1"
        emission_interval_max_frames="4"
        count_min="2" count_max="5"
        randomize_rotation.min="-0.3415"
        randomize_rotation.max="0.3415"
        randomize_angular_velocity.min="-1.3415"
        randomize_angular_velocity.max="1.3415"
        randomize_position.min_x="-4"
        randomize_position.max_x="4"
        randomize_position.min_y="-4"
        randomize_position.max_y="4"
        randomize_velocity.min_x="-6"
        randomize_velocity.max_x="6"
        randomize_velocity.min_y="-6"
        randomize_velocity.max_y="6"
        velocity_always_away_from_center="1" >
	</SpriteParticleEmitterComponent>
	
  <AudioComponent
      file="data/audio/Desktop/projectiles.bank"
      event_root="projectiles/flamethrower">
  </AudioComponent>
  
  <LightComponent 
      _enabled="1"
      radius="80" 
  	  r="255"
  	  g="170"
  	  b="100"
  ></LightComponent>
  
	<VariableStorageComponent
		name="projectile_file"
		value_string="mods/foolish_flame/files/entities/projectiles/laser/projectile.xml"
		>
	</VariableStorageComponent>

</Entity>