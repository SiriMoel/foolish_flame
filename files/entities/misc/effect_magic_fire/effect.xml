<Entity tags="ff_magic_fire_effect">

    <InheritTransformComponent 
		_enabled="1"
    ></InheritTransformComponent>
    
    <GameEffectComponent 
    	effect="CUSTOM"
        custom_effect_id="FF_MAGIC_FIRE"
    	frames="300"
    ></GameEffectComponent>


    <!-- functionality? -->

    <VariableStorageComponent
        _tags="fire_temp"
        name="fire_temp"
        value_int="0"
    ></VariableStorageComponent>

    <LuaComponent
        script_source_file="mods/foolish_flame/files/entities/misc/effect_magic_fire/damage.lua"
        execute_every_n_frame="15"
    ></LuaComponent>

    <LuaComponent
        _tags="ff_expire"
        script_source_file="mods/foolish_flame/files/entities/misc/effect_magic_fire/expire.lua"
        execute_every_n_frame="-1"
        execute_on_added="0"
        execute_on_removed="1"
    ></LuaComponent>


    <!-- vfx -->

    <ParticleEmitterComponent
        _tags="particles_1"
        emitted_material_name="spark_yellow"
        count_min="2"
        count_max="4"
        offset.x="-1"
        offset.y="-5"
        x_pos_offset_min="-4"
        x_pos_offset_max="4"
        y_pos_offset_min="-3"
        y_pos_offset_max="3"
        x_vel_min="-3"
        x_vel_max="3"
        y_vel_min="-15"
        y_vel_max="0"
        lifetime_min="0.1"
        lifetime_max="0.3"
        create_real_particles="0"
        emit_cosmetic_particles="1"
        emission_interval_min_frames="1"
        emission_interval_max_frames="1"
	    delay_frames="2"
        is_emitting="1"
        gravity.x="0"
        gravity.y="-70"
    ></ParticleEmitterComponent>

    <ParticleEmitterComponent
        _tags="particles_2"
        emitted_material_name="spark_red"
        count_min="2"
        count_max="6"
        offset.x="-1"
        offset.y="-5"
        x_pos_offset_min="-6"
        x_pos_offset_max="6"
        y_pos_offset_min="-5"
        y_pos_offset_max="5"
        x_vel_min="-4"
        x_vel_max="4"
        y_vel_min="-30"
        y_vel_max="0"
        lifetime_min="0.2"
        lifetime_max="0.6"
        create_real_particles="0"
        emit_cosmetic_particles="1"
        emission_interval_min_frames="1"
        emission_interval_max_frames="1"
	    delay_frames="2"
        is_emitting="1"
        gravity.x="0"
        gravity.y="-120"
    ></ParticleEmitterComponent>

    <SpriteParticleEmitterComponent
		sprite_file="mods/foolish_flame/files/entities/misc/effect_magic_fire/particles/0.xml"
		delay="0"
		lifetime="0"
		color.r="1" color.g="1" color.b="1" color.a="1"
		color_change.r="0" color_change.g="0" color_change.b="0" color_change.a="0"
        velocity.x="0" velocity.y="0"
        gravity.x="0" gravity.y="0"
        velocity_slowdown="0"
        rotation="0"
        angular_velocity="0"
        use_velocity_as_rotation="0"
        scale.x="1" scale.y="1"
        scale_velocity.x="0" scale_velocity.y="0"
        emission_interval_min_frames="6"
        emission_interval_max_frames="12"
        count_min="0" count_max="2"
        randomize_rotation.min="-0.3415"
        randomize_rotation.max="0.3415"
        randomize_angular_velocity.min="-1.3415"
        randomize_angular_velocity.max="1.3415"
        randomize_position.min_x="-5"
        randomize_position.max_x="5"
        randomize_position.min_y="-3"
        randomize_position.max_y="3"
        randomize_velocity.min_x="-5"
        randomize_velocity.max_x="5"
        randomize_velocity.min_y="-12"
        randomize_velocity.max_y="2"
        velocity_always_away_from_center="1" >
	</SpriteParticleEmitterComponent>


    <!-- audio -->

    <AudioComponent
        file="data/audio/Desktop/misc.bank"
        event_root="game_effect/on_fire"
        set_latest_event_position="1" >
    </AudioComponent>

    <AudioLoopComponent
        file="data/audio/Desktop/misc.bank"
        event_name="game_effect/on_fire/burning" 
        auto_play="1" >
    </AudioLoopComponent>

</Entity>