<Entity name="$projectile_default" >

	<Base file="data/entities/base_projectile.xml" >
		<VelocityComponent
			mass="0.0"
			>
		</VelocityComponent>
	</Base>

  <ProjectileComponent 
    _enabled="1" 
    lob_min="0"
    lob_max="0"
    speed_min="300"
    speed_max="400"
    friction="0.0"
    direction_random_rad="0"
    on_death_explode="0"
    on_death_gfx_leave_sprite="0" 
    on_lifetime_out_explode="0"
    ground_collision_fx="1"
    on_collision_die="0"
    penetrate_entities="1"
    lifetime="12"
    damage="0"
    lifetime_randomness="0"
    ragdoll_force_multiplier="0.01"
    hit_particle_force_multiplier="0.25"
    >
    <damage_by_type
        melee="3"
        fire="6"
        holy="5"
        curse="4"
    ></damage_by_type>
  </ProjectileComponent>
  
  <AudioComponent
      file="data/audio/Desktop/projectiles.bank"
      event_root="player_projectiles/luminous_drill">
  </AudioComponent>

  <SpriteComponent 
    _enabled="1" 
    alpha="1" 
    image_file="mods/foolish_flame/files/entities/misc/bounty/slash_sprite.xml" 
    next_rect_animation=""
    rect_animation="" 
     >
  </SpriteComponent>

  <ParticleEmitterComponent
      emitted_material_name="fire"
      count_min="8"
      count_max="16"
      offset.x="-2"
      offset.y="-10"
        x_pos_offset_min="-32"
        x_pos_offset_max="32"
        y_pos_offset_min="-32"
        y_pos_offset_max="32"
        x_vel_min="-4"
        x_vel_max="4"
        y_vel_min="-30"
        y_vel_max="0"
        lifetime_min="0.2"
        lifetime_max="0.6"
        create_real_particles="0"
        emit_cosmetic_particles="1"
        emission_interval_min_frames="1"
        emission_interval_max_frames="1"
	    delay_frames="2"
        is_emitting="1"
        gravity.x="0"
        gravity.y="-120"
    ></ParticleEmitterComponent>

    <LightComponent 
        radius="120" 
      	r="190"
      	g="140"
      	b="100"
      >
    </LightComponent>

  	<GameAreaEffectComponent
        radius="50"
        collide_with_tag="player_unit"
        frame_length="0"
    ></GameAreaEffectComponent>

    <HitEffectComponent
        effect_hit="LOAD_UNIQUE_CHILD_ENTITY"
        value_string="mods/foolish_flame/files/entities/misc/bounty/homing_projectile_hit_entity.xml"
    ></HitEffectComponent>
  
    <VariableStorageComponent
		  name="projectile_file"
		  value_string="mods/foolish_flame/files/entities/misc/bounty/slash.xml"
		  >
	  </VariableStorageComponent>

</Entity>

